<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 500">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1a1a2e;stop-opacity:0.1"/>
      <stop offset="100%" style="stop-color:#16213e;stop-opacity:0.15"/>
    </linearGradient>
    <linearGradient id="phone" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#141425"/>
      <stop offset="100%" style="stop-color:#1a1a2e"/>
    </linearGradient>
  </defs>
  <rect width="400" height="500" fill="url(#bg)"/>
  <rect x="140" y="40" width="120" height="420" rx="20" fill="url(#phone)" opacity="0.9"/>
  <rect x="150" y="65" width="100" height="370" rx="10" fill="#1a1a2e"/>
  <circle cx="200" cy="52" r="5" fill="#333"/>
  <rect x="175" y="440" width="50" height="4" rx="2" fill="#444"/>
  <rect x="155" y="80" width="90" height="340" rx="5" fill="url(#bg)" opacity="0.3"/>
